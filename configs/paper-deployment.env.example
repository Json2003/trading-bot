# Paper deployment only. Do not place exchange credentials in this file.
TRADING_OPERATOR_MODE=paper
TRADING_OPERATOR_RUNTIME=synthetic-smoke
TRADING_OPERATOR_HOST=127.0.0.1
TRADING_OPERATOR_PORT=8765
TRADING_OPERATOR_CYCLE_SECONDS=1.0
TRADING_OPERATOR_SYNTHETIC_STEPS=2000
TRADING_OPERATOR_SYNTHETIC_SEED=11
TRADING_RESEARCH_DATASET_ROOT=backtest/sample_data
TRADING_RESEARCH_ARTIFACT_ROOT=var/paper_lab
TRADING_RESEARCH_MAX_GENERATIONS=6
TRADING_RESEARCH_MAX_ACCOUNTS=24
# Generate locally; never commit a real token:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADING_OPERATOR_TOKEN=REPLACE_LOCALLY_WITH_A_RANDOM_TOKEN
