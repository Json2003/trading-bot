{
  "name": "splitstar-trading-operator",
  "version": "0.2.0",
  "main": "main.js",
  "description": "Local paper-trading operator console for the rescued trading bot",
  "author": {
    "name": "Splitstar Development",
    "email": "dev@splitstar.io"
  },
  "homepage": "https://github.com/Json2003/trading-bot",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/operator.js",
    "test": "node --test test/*.test.js",
    "build": "npm run check && npm test && electron-builder",
    "dist": "npm run check && npm test && electron-builder -p never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "publish": null,
    "appId": "com.splitstar.tradingbot.operator",
    "productName": "Trading Bot Operator",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/operator.html",
      "renderer/operator.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": ["AppImage"],
      "category": "Finance"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.finance"
    }
  }
}
